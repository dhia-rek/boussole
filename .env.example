# =============================================================================
# Boussole — Environment Variables
# Copy this file to .env and fill in the values you need. Everything is
# optional unless a feature you enable requires it.
# =============================================================================

# -----------------------------------------------------------------------------
# AI: every step runs on Claude through the Claude Code CLI, with your Claude
# subscription (no API key). Sign in once with `claude`; on a server, run
# `claude setup-token` and set CLAUDE_CODE_OAUTH_TOKEN.
# -----------------------------------------------------------------------------
# Claude model alias plus optional reasoning effort.
MODEL=opus:medium
# Default reasoning effort when MODEL has no suffix (low|medium|high|xhigh|max).
# CLAUDE_CLI_EFFORT=medium
# Path to the claude binary.
# CLAUDE_CLI_BIN=claude
# Per-request timeout in milliseconds.
# CLAUDE_CLI_REQUEST_TIMEOUT_MS=180000
# AI agents (LangChain Deep Agents): overall run limit and per-call limit.
# Defaults: 20 minutes and 5 minutes.
# AGENT_RUN_TIMEOUT_MS=1200000
# AGENT_CLI_TIMEOUT_MS=300000

# Optional basic auth for the app and API. App is fully unauthenticated if unset.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# JWT secret for session tokens (>= 32 chars). Generated and stored in
# DATA_DIR if omitted while auth is enabled.
# JWT_SECRET=
# Session token expiry in seconds (default: 86400 = 24h).
# JWT_EXPIRY_SECONDS=86400

# Public base URL used to build tracer links from background/pipeline runs
# where the request host cannot be inferred.
# Example: BOUSSOLE_PUBLIC_BASE_URL=https://boussole.example.com
BOUSSOLE_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Gmail OAuth (post-application tracking inbox) — optional.
# -----------------------------------------------------------------------------
# OAuth client ID for the Gmail integration.
GMAIL_OAUTH_CLIENT_ID=
# OAuth client secret for the Gmail integration.
GMAIL_OAUTH_CLIENT_SECRET=
# Override the OAuth callback URL (defaults to <origin>/oauth/gmail/callback).
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3005/oauth/gmail/callback

# -----------------------------------------------------------------------------
# Account email for automatic login and token refresh.
UKVISAJOBS_EMAIL=
# Account password for automatic login and token refresh.
UKVISAJOBS_PASSWORD=
# Run the UK Visa Jobs browser headless.
UKVISAJOBS_HEADLESS=true

# -----------------------------------------------------------------------------
# Adzuna source (multi-country API) — optional.
# -----------------------------------------------------------------------------
# Adzuna application ID.
ADZUNA_APP_ID=
# Adzuna application key.
ADZUNA_APP_KEY=
# Default per-term result cap (UI run budget can override).
# ADZUNA_MAX_JOBS_PER_TERM=50

# -----------------------------------------------------------------------------
# Apify API token (https://console.apify.com/account/integrations).
APIFY_TOKEN=
# Default per-term result cap (UI run budget can override).
# SEEK_MAX_JOBS_PER_TERM=50
# Override the Apify actor used for Seek scraping.
# SEEK_APIFY_ACTOR_ID=unfenced-group/seek-com-au-scraper

# -----------------------------------------------------------------------------
# JobSpy source (Glassdoor/Indeed/LinkedIn) — optional.
# -----------------------------------------------------------------------------
# Filter for remote-only jobs (1 = enabled, 0 = disabled).
# JOBSPY_IS_REMOTE=0

# -----------------------------------------------------------------------------
# Brave Search source — optional (get a key at search.brave.com/search/api).
# -----------------------------------------------------------------------------
# Brave Search API key.
BRAVE_SEARCH_API_KEY=your_key_here
